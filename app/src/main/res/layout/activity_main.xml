<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <!-- Main scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="160dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="RayNeo OCR"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/tvAiMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Loading..."
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:background="#1E1E1E"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>

            <!-- Image Preview Card -->
            <androidx.cardview.widget.CardView
                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                card_view:cardCornerRadius="12dp"
                card_view:cardBackgroundColor="#1A1A1A"
                card_view:cardElevation="4dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="4dp"/>

                    <TextView
                        android:id="@+id/tvImageHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="📷 Tap Camera or Gallery"
                        android:textColor="#555555"
                        android:textSize="16sp"/>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Camera + Gallery Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnCamera"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:text="📷 Camera"
                    android:textSize="13sp"
                    android:backgroundTint="#1F6FEB"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"/>

                <Button
                    android:id="@+id/btnGallery"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:text="🖼 Gallery"
                    android:textSize="13sp"
                    android:backgroundTint="#1F6FEB"
                    android:textColor="#FFFFFF"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Language Spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Language"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="#1A1A1A"
                android:paddingHorizontal="12dp"
                android:popupBackground="#1A1A1A"/>

            <!-- Extract Button -->
            <Button
                android:id="@+id/btnExtract"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="🔍  Extract Text"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#7C4DFF"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"
                android:stateListAnimator="@null"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Extracted Text Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📄 EXTRACTED TEXT"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <androidx.cardview.widget.CardView
                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                card_view:cardCornerRadius="10dp"
                card_view:cardBackgroundColor="#1A1A1A"
                card_view:cardElevation="2dp">

                <TextView
                    android:id="@+id/tvExtracted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:padding="14dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textIsSelectable="true"
                    android:hint="Extracted text appears here..."
                    android:textColorHint="#444444"/>
            </androidx.cardview.widget.CardView>

            <!-- AI Answer Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 AI ANSWER"
                android:textColor="#888888"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp"/>

            <androidx.cardview.widget.CardView
                xmlns:card_view="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                card_view:cardCornerRadius="10dp"
                card_view:cardBackgroundColor="#0D2137"
                card_view:cardElevation="2dp">

                <TextView
                    android:id="@+id/tvAnswer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:padding="14dp"
                    android:textColor="#00E5FF"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.6"
                    android:textIsSelectable="true"
                    android:hint="Answer appears here..."
                    android:textColorHint="#1A4A6A"/>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#111111"
        android:elevation="8dp"
        app:layout_anchor="@id/scrollView"
        app:layout_anchorGravity="bottom"
        android:layout_gravity="bottom">


        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#2A2A2A"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etQuestion"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:hint="Ask a question about the text..."
                android:textColor="#FFFFFF"
                android:textColorHint="#555555"
                android:textSize="14sp"
                android:background="#1E1E1E"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:maxLines="1"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnAsk"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:text="Ask"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#7C4DFF"
                android:textColor="#FFFFFF"
                android:stateListAnimator="@null"/>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>